# web-search skill keys
# Priority: environment variable > this file > .env.qoder
# AnySearch works anonymously without a key (lower rate limits).

# Optional, recommended for higher AnySearch rate limits
ANYSEARCH_API_KEY=

# Required for the TinyFish provider (https://api.search.tinyfish.ai)
TINYFISH_API_KEY=

# Required for the Tavily provider (https://api.tavily.com)
TAVILY_API_KEY=
